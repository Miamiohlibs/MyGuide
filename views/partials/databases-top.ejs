<!-- begin partials/databases-top -->
<div class="accordion" id="accordion-<%= subjNoSpaces %>">
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingTop-<%= subjNoSpaces %>">
      <div class="accordion-button accordion-top-db-button">
        Top and Favorite Databases
      </div>
    </h2>
    <div id="collapseTop-<%= subjNoSpaces %>" class="accordion-collapse collapse show" aria-labelledby="headingTop-<%= subjNoSpaces %>">
      <div class="accordion-body">
        <ul class="list-unstyled" id="topDatabasesList">
          <% databases.aboveFold.forEach(d => { %>
            <%- include('database-item', {d: d}) %>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
  <div class="accordion-item">
    <h2 class="accordion-header" id="headingOther-<%= subjNoSpaces %>">
      <button class="accordion-button collapsed other-db-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOther-<%= subjNoSpaces %>" aria-expanded="false" aria-controls="collapseOther-<%= subjNoSpaces %>">
        Additional <%= subjName %> Databases
      </button>
    </h2>
    <div id="collapseOther-<%= subjNoSpaces %>" class="accordion-collapse collapse" aria-labelledby="headingOther-<%= subjNoSpaces %>" data-bs-parent="#accordion-<%= subjNoSpaces %>">
      <div class="accordion-body">
        <ul class="list-unstyled" id="otherDatabasesList">
          <% databases.belowFold.forEach(d => { %>
            <%- include('database-item', {d: d}) %>
            <% }) %>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- end partials/databases-top -->